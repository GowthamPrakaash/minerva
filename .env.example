# Environment Template - Copy this file to .env and fill in your values
# DO NOT commit the .env file to version control!

# API Keys
SARVAM_API_KEY=your_sarvam_api_key_here

# Security
AUTH_DISABLED=false

# AWS Credentials (Required if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name

# Pulumi Infrastructure Config
PULUMI_CONFIG_PASSPHRASE=your_pulumi_passphrase

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minerva
DB_USER=postgres
DB_PASSWORD=your_db_password

# Storage Configuration
# Options: local, s3
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/tmp/data/

# Application Settings
PYTHONPATH=.
TENANT_SCHEMA=tenant_golden_bricks
